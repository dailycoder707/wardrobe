# Copy this file to keystore.properties (repo root, gitignored) and fill in real
# values to produce a Play-Store-signed release build. Without this file,
# assembleRelease still succeeds locally by falling back to debug signing —
# see app/build.gradle.kts's signingConfigs block and Phase 1 Section 10 (roadmap).
storeFile=/absolute/path/to/release-keystore.jks
storePassword=changeme
keyAlias=wardrobe-release
keyPassword=changeme
