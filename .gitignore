# Build outputs
*/build/
build/
.gradle/
captures/
.cxx/

# Local machine config — never commit
local.properties
keystore.properties

# Claude Code per-machine tool permissions. `.claude/settings.json` (shared,
# checked in when it exists) is deliberately NOT ignored — only the
# `.local.` variant, which records one developer's own approved commands.
.claude/settings.local.json

# Android Studio / IntelliJ
.idea/
*.iml
.DS_Store

# Gradle wrapper distribution cache (jar + properties are committed; the
# downloaded distribution itself is not)
gradle/wrapper/dists/
